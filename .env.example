# ──────────────────────────────────────────────────────────────────────────────
# Extrator e Filtro de P&R (Local) — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before running.
# .env is gitignored; .env.example is tracked for reference.
# ──────────────────────────────────────────────────────────────────────────────

# Application environment (development | production)
APP_ENV=development

# OpenAI API key — can also be managed via the in-app Settings UI
# and stored in the Docker volume (data/keys.json).
# If set here, it will be used as the default key on startup.
OPENAI_API_KEY=

# Directory for persistent JSON storage (keys, prompts) inside the container.
# Do not change this unless you also update docker-compose.yml volumes.
DATA_DIR=/app/data

# Backend server bind settings
HOST=0.0.0.0
PORT=8100
